# Copy to .env on the server and fill in. .env is git-ignored; this file is not.

# Public address of the service. Short links and QR codes are built from it,
# and an https value is what marks the session cookie Secure.
TEENYURL_BASE_URL=https://url.example.com

# At least 12 characters. Compared as-is rather than hashed, so its length is
# the strength it has. See DESIGN-DECISIONS.md.
TEENYURL_ADMIN_PASSWORD=

# The existing Docker network your reverse proxy is on. Compose joins it as
# external, so the name has to match one that is already there; a name that
# does not exist fails the deploy rather than creating anything. To list them:
#   docker network ls
TEENYURL_NETWORK=proxy

# Peers allowed to set X-Forwarded-For. This is the subnet of the network
# above, where the proxy sits. To confirm it on your host:
#   docker network inspect "$TEENYURL_NETWORK" --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# Too narrow is the failure that bites: every request is then attributed to
# the proxy, so five wrong passwords lock everyone out for fifteen minutes.
TEENYURL_TRUSTED_PROXIES=172.18.0.0/16,127.0.0.1/32,::1/128

# Optional, with the defaults shown.
# TEENYURL_SESSION_TTL=24h
# TEENYURL_FLUSH_INTERVAL=30s
# TEENYURL_CODE_LEN=6
